{
    "$schema": "http://json.schemastore.org/template",
    "author": "Angelo Pirola",
	"classifications": [ "Web", "API", "ASP.NET", "Minimal API" ],
	"identity": "MinimalApi.Template",
	"name": "ASP.NET Core Web Minimal API custom",
	"description": "Un template per creare un progetto ASP.NET Core Web Minimal API con un approccio minimalista, personalizzato per le mie esigenze.",
	"shortName": "minimalapi",
	"sourceName": "MinimalApi.Template",
	"preferNameDirectory": true,
	"tags": {
		"language": "C#",
		"type": "project"
	},
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                "**/[Bb]in/**",
                "**/[Oo]bj/**",
                ".template.config/**/*",
                ".artifacts/**",
                ".github/FUNDING.yml",
                ".github/workflows/publish.yml",
                ".vs/**"
            ],
            "modifiers": [
                {
                    "rename": {
                        "_gitignore": ".gitignore"
                    }
                }
            ]
        }
    ],
    "symbols": {
        "framework": {
            "type": "parameter",
            "choices": [
                { "choice": "net10.0" }
            ],
            "defaultValue": "net10.0",
            "replaces": "TargetFrameworkToken"
        }
    }
}